# Copy this file to .env.local (or .env.development) inside the frontend folder.
# Vite is configured to read env files from this directory even when commands
# are executed from the repository root with --prefix frontend.

# Toggle to use the external backend instead of connecting directly to MongoDB
VITE_USE_BACKEND=false
# URL of the backend that exposes predictive data
VITE_BACKEND_URL=http://localhost:8000

# Direct MongoDB connection (default flow when VITE_USE_BACKEND is false)
# Provide your MongoDB connection string and database name; the frontend will connect
# with the MongoDB Node.js driver without requiring a Data API key or data source.
VITE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>
VITE_MONGO_DATABASE=ecommerce_brazil
# Comma separated list of collections to query. Defaults to processed_results_gmm, processed_results_kmeans, processed_results_minibatch
VITE_MONGO_COLLECTIONS=processed_results_gmm,processed_results_kmeans,processed_results_minibatch
