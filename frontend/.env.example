# Toggle to use the external backend instead of the Mongo Data API.
# Set this to true when you only have a Mongo URI + database name and cannot expose the Data API from the frontend.
VITE_USE_BACKEND=false
# URL of the backend that exposes predictive data
VITE_BACKEND_URL=http://localhost:8000

# MongoDB Data API configuration (default flow when VITE_USE_BACKEND is false)
VITE_MONGO_DATA_API_URL=https://data.mongodb-api.com/app/<app-id>/endpoint/data/v1
VITE_MONGO_DATA_API_KEY=<your-api-key>
VITE_MONGO_DATA_SOURCE=Cluster0
VITE_MONGO_DATABASE=ccd
# Comma separated list of collections to query. Defaults to processed_results_gmm, processed_results_kmeans, processed_results_minibatch
VITE_MONGO_COLLECTIONS=processed_results_gmm,processed_results_kmeans,processed_results_minibatch
